        "def analyse_reads(reads, reference):\n",
        "    \"\"\"Validates each read and checks for mutations against reference if valid and\n",
        " returns a new list\"\"\"\n",
        "    analysed_reads = []\n",
        "    for read in reads:\n",
        "\n",
        "   # this runs step 1 to see if read is valid or not\n",
        "      validation_result = validate_read(read[\"sequence\"], reference)\n",
        "      normalised_sequence = validation_result[\"sequence\"]\n",
        "      is_valid = validation_result[\"valid\"]\n",
        "      errors = validation_result[\"errors\"]\n",
        "\n",
        "   # if it passed, search for mutation if none leave blank\n",
        "      if is_valid:\n",
        "            status = \"valid\"\n",
        "            mutations = find_mutations(normalised_sequence, reference)\n",
        "      else:\n",
        "            status = \"invalid\"\n",
        "            mutations = []\n",
        "# gets all info into new dictionary for this read\n",
        "      analysed_read = {\n",
        "          \"read_id\": read[\"read_id\"],\n",
        "          \"sample\": read[\"sample\"],\n",
        "          \"group\": read[\"group\"],\n",
        "          \"sequence\": normalised_sequence,\n",
        "          \"status\": status,\n",
        "          \"errors\": errors,\n",
        "          \"mutations\": mutations\n",
        "\n",
        "      }\n",
        "      #add to list and repeat\n",
        "      analysed_reads.append(analysed_read)\n",
        "    return analysed_reads\n"
