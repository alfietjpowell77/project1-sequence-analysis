        "def get_top_positions(position_counts):\n",
        "    \"\"\"returns max 3 positions with the highest mismatch counts\"\"\"\n",
        "    def sort_helper(pos_num):\n",
        "        frequency = position_counts[pos_num]\n",
        "        #sorts by frequency, highest to lowest, if frequency is the same go with lowest position number first\n",
        "        return (-frequency, pos_num)\n",
        "\n",
        "\n",
        "    sorted_positions = sorted(position_counts.keys(), key=sort_helper)\n",
        "    return sorted_positions[:3]\n",
        "\n",
        "\n",
        "def summarise_samples(analysed_reads):\n",
        "    \"\"\"summarises mismatch statistics per sample and print a summary section\"\"\"\n",
        "    if not analysed_reads:\n",
        "        #handles edge cases\n",
        "        return {}\n",
        "\n",
        "\n",
        "    summary_results = {}\n",
        "\n",
        "\n",
        "    # collects metrics for each sample\n",
        "    for read in analysed_reads:\n",
        "        sample = read[\"sample\"]\n",
        "        group = read[\"group\"]\n",
        "        status = read[\"status\"]\n",
        "\n",
        "        if sample not in summary_results:\n",
        "            summary_results[sample] = {\n",
        "                \"group\": group,\n",
        "                \"valid_reads\": 0,\n",
        "                \"invalid_reads\": 0,\n",
        "                \"mismatch_reads\": 0,\n",
        "                \"mismatch_percentage\": None,\n",
        "                \"mismatch_events\": 0,\n",
        "                \"substitution_counts\": {},\n",
        "                \"position_counts\": {},\n",
        "                \"top_positions\": []\n",
        "            }\n",
        "\n",
        "#converts raw data to clear summary reports\n",
        "        if status == \"valid\":\n",
        "            summary_results[sample][\"valid_reads\"] += 1\n",
