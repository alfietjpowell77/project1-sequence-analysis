      "source": [
        "def validate_read(sequence, reference):\n",
        "    \"\"\"this checks if a read sequence matches the reference length and only contains A,T,C,G\"\"\"\n",
        "#any errors found will go into the empty list\n",
        "    errors = []\n",
        "\n",
        "# if sequence length isnt the same as reference length, wrong_length will be\n",
        "# added to error list\n",
        "    if len(sequence) != len(reference):\n",
        "      errors.append(\"wrong_length\")\n",
        "#valid lowercase letters will be capatilised\n",
        "#any invalid characters within the whole sequence will be added to errors[]\n",
        "#break stops the loop after finding the first invalid character\n",
        "    upper_seq = sequence.upper()\n",
        "    for base in upper_seq:\n",
        "      if base not in [\"A\", \"C\", \"G\", \"T\"]:\n",
        "        errors.append(\"invalid_characters\")\n",
        "        break\n",
        "#means code is only valid if 0 errors\n",
        "    if len(errors) == 0:\n",
        "      is_valid = True\n",
        "    else:\n",
        "      is_valid = False\n",
        "\n",
        "\n",
        "    return{\n",
        "        \"sequence\": upper_seq,\n",
        "        \"valid\": is_valid,\n",
        "        \"errors\": errors\n",
        "    }\n",
        "\n",
        "\n",
        "\n"
