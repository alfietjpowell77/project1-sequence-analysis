        "            pos_counts = data[\"position_counts\"]\n",
        "            mutations_at_pos = pos_counts.get(pos, 0)\n",
        "\n",
        "            pct = (mutations_at_pos / valid_reads) * 100\n",
        "\n",
        "            if group == control_group:\n",
        "                control_percentages.append(pct)\n",
        "            elif group == treated_group:\n",
        "                treated_percentages.append(pct)\n",
        "\n",
        "\n",
        "        #stats test in notebook\n",
        "        stats_result = calculate_statistics(control_percentages, treated_percentages)\n",
        "        control_n = len(control_percentages)\n",
        "        treated_n = len(treated_percentages)\n",
        "\n",
        "        control_mean = sum(control_percentages) / control_n if control_n > 0 else None\n",
        "        treated_mean = sum(treated_percentages) / treated_n if treated_n > 0 else None\n",
        "        difference = (treated_mean - control_mean) if (treated_mean is not None and control_mean is not None) else None\n",
        "\n",
        "        stat_val = stats_result[\"statistic\"]\n",
        "        p_val = stats_result[\"p_value\"]\n",
        "\n",
        "        if control_mean is not None:\n",
        "            c_mean_str = f\"{control_mean:.2f}%\"\n",
        "        else:\n",
        "            c_mean_str = \"N/A\"\n",
        "\n",
        "        if treated_mean is not None:\n",
        "            t_mean_str = f\"{treated_mean:.2f}%\"\n",
        "        else:\n",
        "            t_mean_str = \"N/A\"\n",
        "\n",
        "        if difference is not None:\n",
        "            diff_str = f\"{difference:.2f}%\"\n",
        "        else:\n",
        "            diff_str = \"N/A\"\n",
        "\n",
        "        if p_val is not None:\n",
        "            p_val_str = f\"{p_val:.4f}\"\n",
        "        else:\n",
        "            p_val_str = \"N/A\"\n",
