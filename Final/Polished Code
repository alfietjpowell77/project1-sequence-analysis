        "    \"\"\"compare mutation % between control + treatment\"\"\"\n",
        "    if not sample_summary:\n",
        "        return []\n",
        "\n",
        "    #dicts for control and treatment totals\n",
        "    control_totals = {}\n",
        "    treated_totals = {}\n",
        "\n",
        "    #this loops through all samples to sum mutation counts\n",
        "    for sample, data in sample_summary.items():\n",
        "        group = data[\"group\"]\n",
        "        pos_counts = data[\"position_counts\"]\n",
        "\n",
        "        for pos, count in pos_counts.items():\n",
        "            if group == control_group:\n",
        "                if pos not in control_totals:\n",
        "                    control_totals[pos] = 0\n",
        "                control_totals[pos] += count\n",
        "            elif group == treated_group:\n",
        "                if pos not in treated_totals:\n",
        "                    treated_totals[pos] = 0\n",
        "                treated_totals[pos] += count\n",
        "\n",
        "    #combine key positions\n",
        "    all_positions = set(control_totals.keys())\n",
        "    for pos in treated_totals:\n",
        "        all_positions.add(pos)\n",
        "\n",
        "    combined = {}\n",
        "    for pos in all_positions:\n",
        "        c_count = control_totals.get(pos, 0)\n",
        "        t_count = treated_totals.get(pos, 0)\n",
        "        combined[pos] = c_count + t_count\n",
        "\n",
        "    #sort by highest count, if position numbers are the same, lowest number wins\n",
        "    def sort_helper(pos_num):\n",
        "        frequency = combined[pos_num]\n",
        "        return (-frequency, pos_num)\n",
        "\n",
        "    top_positions = sorted(combined.keys(), key=sort_helper)[:3]\n",
        "    results = []\n",
        "\n",
        "\n",
        "    #prints table header row\n",
        "    print(\"\\n=== Analysis of Top Mismatch Positions ===\")\n",
        "    print(f\" {'Position':<15} {'Control Mean %':<20} {'Treated Mean %':<20} {'Difference':<15} {'p_value':<10} \")\n",
        "    print(\"-\" * 80)\n",
        "\n",
        "\n",
        "    #loop through top 3 + calculates % per sample\n",
        "    for pos in top_positions:\n",
        "        control_percentages = []\n",
        "        treated_percentages = []\n",
        "\n",
        "        for sample, data in sample_summary.items():\n",
