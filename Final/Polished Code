      "source": [
        "def find_mutations(sequence, reference):\n",
        "    \"\"\"function that finds mutations based off 2 variables\"\"\"\n",
        "    #any mutations found will go into the empty list\n",
        "    mutations = []\n",
        "    # loops through whole sequence to track position and actual letter\n",
        "    for index, base in enumerate(sequence):\n",
        "      if base != reference[index]:\n",
        "        mutation_dict = {\n",
        "            \"position\": index + 1,\n",
        "            \"reference_base\": reference[index],\n",
        "            \"read_base\": base\n",
        "        }\n",
        "        mutations.append(mutation_dict)\n",
        "    return mutations\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n"
